# Keep line endings predictable across Windows and macOS checkouts rather than
# leaving them to each developer's core.autocrlf. A shell script that arrives
# with CRLF fails on macOS with "bad interpreter: /usr/bin/env bash^M".
* text=auto

*.sh text eol=lf
*.ps1 text eol=crlf

*.zip binary
*.pcap binary
*.pcapng binary
*.evtx binary
*.png binary
*.jpg binary
*.ico binary
